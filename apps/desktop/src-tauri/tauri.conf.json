{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcvox",
  "version": "../package.json",
  "identifier": "com.howar31.arcvox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Arcvox",
        "url": "settings.html",
        "width": 1120,
        "height": 868,
        "minWidth": 1120,
        "minHeight": 780,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "widget",
        "title": "Arcvox Widget",
        "url": "widget.html",
        "width": 140,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      },
      {
        "label": "panel",
        "title": "Arcvox Panel",
        "url": "panel.html",
        "width": 240,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyODFBNjEyN0E5NTY1ODgKUldTSVpaVjZFcWFCWXBLZnJTVWVCekFJd1FzVlM1WEIra1U0RmpJNGt4QVFiaDdCSEJFMmFmZDUK",
      "endpoints": ["https://github.com/howar31/arcvox/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/AppIcon.icon"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
